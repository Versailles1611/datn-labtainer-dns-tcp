# goals.config
# Please see the Labtainer Lab Designer Guide

# Tasks for the TCP RST hijacking lab:
#   1) open a TCP session between victim and server
#   2) tear the session down with a spoofed RST packet
#   3) capture the session traffic with tcpdump
#   4) verify the victim ARP cache was poisoned

tcp_session_established = boolean : cw_tcp_session
session_torn_down = boolean : cw_tcp_session_closed
rst_captured = boolean : cw_rst_capture
arp_cache_poisoned = boolean : cw_arp_spoof

#DOC: The TCP session was torn down with a spoofed RST packet
all_passed = boolean : (tcp_session_established and session_torn_down)
