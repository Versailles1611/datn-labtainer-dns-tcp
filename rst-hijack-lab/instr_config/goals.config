# goals.config
# Please see the Labtainer Lab Designer Guide

# Nhiem vu cua sinh vien:
#   1) Tao goi tin RST de dong phien TCP giua victim va server
#   2) Kiem tra phien TCP da duoc dong (CONNECTION CLOSED)
#   3) Xac minh ARP cua victim chua tro den MAC cua attacker

rst_hijacked_ok = boolean : _tcp_rst_sent
session_closed_ok = boolean : _tcp_session_closed
arp_correct_ok = boolean : _tcp_rst_effect

#DOC: Dong phien TCP bang goi tin RST
all_passed = boolean : (rst_hijacked_ok and session_closed_ok and arp_correct_ok)
