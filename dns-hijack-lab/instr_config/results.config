#
#CHECK_OK: Tat ca kiem tra DNS Hijacking deu DAT.
#
# === Cac ket qua dung de xep hang ===
_resolver_set = victim:prestop.stdout : FILE_REGEX : nameserver 172.20.0.4
_rogue_answer = victim:prestop.stdout : FILE_REGEX : 172.20.0.99
_rogue_query  = attacker:prestop.stdout : FILE_REGEX : 172.20.0.2#.*query: portal.lab.local
_rogue_conf   = attacker:prestop.stdout : FILE_REGEX : portal  IN  A   172.20.0.99

# === Checkwork feedback (it nhat 3 kiem tra) ===
#CHECK_TRUE: Cau hinh DNS cua nan nhan chua chuyen sang rogue server (172.20.0.4)
cw_resolver = victim:prestop.stdout : FILE_REGEX : nameserver 172.20.0.4
#CHECK_TRUE: DNS tu victim chua tra ve IP gia mao 172.20.0.99 (nan nhan chua bi pharming)
cw_rogue_answer = victim:prestop.stdout : FILE_REGEX : 172.20.0.99
#CHECK_TRUE: Rogue server chua ghi nhan truy van nao tu nan nhan (172.20.0.2)
cw_rogue_query = attacker:prestop.stdout : FILE_REGEX : 172.20.0.2#.*query: portal.lab.local
#CHECK_TRUE: Zone tren attacker chua duoc cau hinh tra ve IP gia mao 172.20.0.99
cw_rogue_conf = attacker:prestop.stdout : FILE_REGEX : portal  IN  A   172.20.0.99
