# goals.config
# 
# Please see the Labtainer Lab Designer Guide
#
# Muc tieu cua sinh vien:
#   1) Chuyen /etc/resolv.conf cua victim ve rogue server (172.20.0.4)
#   2) Rogue DNS tra ve IP gia mao 172.20.0.99 cho portal.lab.local
#   3) Rogue server ghi nhan duoc truy van tu victim
#
victim_resolver = boolean : _resolver_set
rogue_answer    = boolean : _rogue_answer
rogue_query     = boolean : _rogue_query
rogue_conf      = boolean : _rogue_conf

#DOC: Da khai thac thanh cong DNS Hijacking tu dau den cuoi
all_passed = boolean : (victim_resolver and rogue_answer and rogue_query and rogue_conf)
