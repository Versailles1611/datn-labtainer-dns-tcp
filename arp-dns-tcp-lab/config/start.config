# Filename : start.config
# Description:
#     ARP-level DNS Poisoning + TCP Hijacking lab
#

GLOBAL_SETTINGS
	GRADE_CONTAINER server
	HOST_HOME_XFER seed_dir/
	LAB_MASTER_SEED arp-dns-tcp-lab_seed

NETWORK LAN
     MASK 192.168.0.0/24
     GATEWAY 192.168.0.101

CONTAINER user
	USER ubuntu
    	LAN 192.168.0.100
    	NO_GW YES
    	REGISTRY haiyen1102

CONTAINER apollo-dns
	USER ubuntu
    	LAN 192.168.0.10
    	REGISTRY haiyen1102

CONTAINER server
	USER ubuntu
    	LAN 192.168.0.3
    	NO_GW YES
    	REGISTRY haiyen1102

CONTAINER attacker
	USER ubuntu
    	LAN 192.168.0.200
    	NO_GW YES
    	REGISTRY haiyen1102
