#!/bin/bash
for i in $(seq 1 30); do
    ip -4 addr show eth0 2>/dev/null | grep -q "inet " && break
    sleep 1
done
# lab starts with the gateway entry already poisoned (attacker MAC)
ip neigh replace 192.168.0.101 lladdr 02:42:c0:a8:00:c8 dev eth0 nud permanent
chown -R bind:bind /var/cache/bind
service bind9 start
exit 0
