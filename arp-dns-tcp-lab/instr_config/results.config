#CHECK_OK: ARP poisoning, DNS cache poisoning and TCP hijacking all succeeded.

# 1) the user ARP cache points at the attacker MAC (02:42:c0:a8:00:c8)
cw_arp_spoof = user:prestop.stdout : CONTAINS : 02:42:c0:a8:00:c8
# 2) apollo-dns cache was poisoned with the fake address
cw_dns_poison = apollo-dns:prestop.stdout : CONTAINS : 10.99.0.99
# 3) the user opened a TCP session with the server
cw_tcp_session = server:prestop.stdout : CONTAINS : HELLO
# 4) the attacker injected data into that session
cw_tcp_hijacked = server:prestop.stdout : CONTAINS : HIJACKED
