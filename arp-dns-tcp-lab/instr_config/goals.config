# goals.config
# Please see the Labtainer Lab Designer Guide

# Nhiem vu cua sinh vien:
#   1) Thuc hien ARP spoofing de giua user va apollo-dns
#   2) Cau hong cache DNS Apollo de tra ve IP gia mao 10.99.0.99
#   3) Mo phien TCP toi server tu user
#   4) Chen goi tin gia mao HIJACKED vao phien

arp_poison_ok = boolean : _arp_spoof
dns_cache_poison_ok = boolean : _dns_poison
tcp_session_ok = boolean : _tcp_session
tcp_hijacked_ok = boolean : _tcp_hijacked

#DOC: Dai hack thanh cong tong quat tu ARP cho den chen goi tin
all_passed = boolean : (arp_poison_ok and dns_cache_poison_ok and tcp_session_ok and tcp_hijacked_ok)
