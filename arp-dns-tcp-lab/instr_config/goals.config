# goals.config
# Please see the Labtainer Lab Designer Guide

# Tasks for the ARP + DNS + TCP lab:
#   1) poison the user ARP cache
#   2) poison the apollo-dns cache
#   3) open a TCP session between user and server
#   4) inject data into the TCP session

arp_spoofed = boolean : cw_arp_spoof
dns_poisoned = boolean : cw_dns_poison
tcp_session = boolean : cw_tcp_session
tcp_hijacked = boolean : cw_tcp_hijacked

#DOC: ARP-level DNS poisoning followed by a TCP hijack
all_passed = boolean : (arp_spoofed and dns_poisoned and tcp_session and tcp_hijacked)
