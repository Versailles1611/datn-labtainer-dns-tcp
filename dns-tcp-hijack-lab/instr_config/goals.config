# goals.config
# Please see the Labtainer Lab Designer Guide

# Tasks for the DNS + TCP hijacking lab:
#   1) redirect the victim resolver to the attacker
#   2) answer DNS queries with the fake address 172.21.0.99
#   3) open a TCP session between victim and server
#   4) inject data into the TCP session

dns_redirect = boolean : cw_dns_redirect
fake_answer = boolean : cw_fake_dns_answer
tcp_session = boolean : cw_tcp_session
tcp_hijacked = boolean : cw_tcp_hijacked

#DOC: DNS redirection followed by a TCP session hijack
all_passed = boolean : (dns_redirect and fake_answer and tcp_session and tcp_hijacked)
