# goals.config
# Please see the Labtainer Lab Designer Guide

# Nhiem vu cua sinh vien:
#   1) Cau hong DNS de chuyen huong truy van toi may attacker
#   2) Mo phien TCP toi server tu victim
#   3) Sniff phien TCP de lay so SEQ/ACK
#   4) Chen goi tin gia mao HIJACKED vao phien

dns_redirect_ok = boolean : _dns_redirect
dns_fake_answer_ok = boolean : _dns_fake_answer
tcp_session_ok = boolean : _tcp_session
tcp_hijacked_ok = boolean : _tcp_hijacked

#DOC: Dai hack thanh cong tong quat tu DNS chuan bi den chen goi tin
all_passed = boolean : (dns_redirect_ok and dns_fake_answer_ok and tcp_session_ok and tcp_hijacked_ok)
