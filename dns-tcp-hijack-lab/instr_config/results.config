# results.config
# Please see the Labtainer Lab Designer Guide
#
#CHECK_OK: DNS redirection and TCP hijacking both succeeded.

# 1) the victim resolver was redirected to the attacker
cw_dns_redirect = victim:prestop.stdout : FILE_REGEX : nameserver 172\.21\.0\.4
# 2) the rogue DNS server handed out the fake address
cw_fake_dns_answer = victim:prestop.stdout : CONTAINS : 172.21.0.99
# 3) the victim opened a TCP session with the server
cw_tcp_session = server:prestop.stdout : CONTAINS : HELLO
# 4) the attacker injected data into that session
cw_tcp_hijacked = server:prestop.stdout : CONTAINS : HIJACKED
