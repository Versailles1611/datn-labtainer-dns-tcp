#CHECK_OK: Tat ca kiem tra DNS hijacking va TCP chiu thanh cong.
#

# === Ket qua chung ===
_dns_redirect = victim:prestop.stdout : FILE_REGEX : nameserver 172.21.0.4
_dns_fake_answer = victim:prestop.stdout : FILE_REGEX : 172.21.0.99
_tcp_session = server:prestop.stdout : FILE_REGEX : HELLO
_tcp_hijacked = server:prestop.stdout : CONTAINS : HIJACKED
_tcp_sniffed = attacker:prestop.stdout : FILE_REGEX : \.9999
_tcp_arp = victim:prestop.stdout : FILE_REGEX : 02:42:ac:15:00:04

# === Checkwork feedback ===
cw_dns_redirect = victim:prestop.stdout : FILE_REGEX : nameserver 172.21.0.4
cw_dns_fake_answer = victim:prestop.stdout : FILE_REGEX : 172.21.0.99
cw_tcp_session = server:prestop.stdout : FILE_REGEX : HELLO
cw_tcp_hijacked = server:prestop.stdout : CONTAINS : HIJACKED
cw_tcp_sniffed = attacker:prestop.stdout : FILE_REGEX : \.9999
cw_tcp_arp = victim:prestop.stdout : FILE_REGEX : 02:42:ac:15:00:04
