# results.config
# Please see the Labtainer Lab Designer Guide
#
# Tat ca ket qua duoc doc tu output cua analyst:prestop.stdout.
#
#CHECK_OK: Tat ca dau hieu tan cong TCP da duoc phat hien.

# === 1. SYN flood ===
#CHECK_TRUE: Chua xac dinh dung IP nguon cua SYN flood (SYN_FLOOD_SRC)
cw_syn_src = analyst:prestop.stdout : CONTAINS : SYN_FLOOD_SRC=172.22.0.5
#CHECK_TRUE: Chua dem dung so goi SYN trong capture (SYN_COUNT)
cw_syn_count = analyst:prestop.stdout : CONTAINS : SYN_COUNT=120

# === 2. RST injection ===
#CHECK_TRUE: Chua tim dung sequence number cua goi RST gia mao (RST_SEQ)
cw_rst_seq = analyst:prestop.stdout : CONTAINS : RST_SEQ=1007
#CHECK_TRUE: Chua xac dinh dung MAC cua ke tan cong trong goi RST (RST_SRC_MAC)
cw_rst_mac = analyst:prestop.stdout : CONTAINS : RST_SRC_MAC=02:42:ac:16:00:05

# === 3. Session hijacking ===
#CHECK_TRUE: Chua tim dung sequence number cua du lieu bi chen (HIJACK_SEQ)
cw_hijack_seq = analyst:prestop.stdout : CONTAINS : HIJACK_SEQ=7007
#CHECK_TRUE: Chua xac dinh dung payload bi chen (HIJACK_PAYLOAD)
cw_hijack_payload = analyst:prestop.stdout : CONTAINS : HIJACK_PAYLOAD=HIJACKED

# === 4. Live SYN port scan ===
#CHECK_TRUE: Chua xac dinh dung IP cua may quet cong (LIVE_SCAN_SRC)
cw_live_scan_src = analyst:prestop.stdout : CONTAINS : LIVE_SCAN_SRC=172.22.0.5
#CHECK_TRUE: Chua bat duoc capture live-scan.pcap co du dau hieu quet cong
cw_live_scan_file = analyst:prestop.stdout : CONTAINS : LIVE_SCAN=OK
