# goals.config
# Please see the Labtainer Lab Designer Guide
#
# Nhiem vu cua sinh vien (phat hien tan cong TCP):
#   1) Phat hien SYN flood trong capture tinh
#   2) Phat hien RST injection trong capture tinh
#   3) Phat hien session hijacking trong capture tinh
#   4) Bat song va phat hien SYN port scan
#
syn_flood_identified = boolean : (cw_syn_src and cw_syn_count)
rst_injection_identified = boolean : (cw_rst_seq and cw_rst_mac)
session_hijack_identified = boolean : (cw_hijack_seq and cw_hijack_payload)
live_port_scan_identified = boolean : (cw_live_scan_src and cw_live_scan_file)

#DOC: Da phat hien day du 4 loai tan cong TCP (SYN flood, RST injection, session hijack, SYN scan)
all_passed = boolean : (syn_flood_identified and rst_injection_identified and session_hijack_identified and live_port_scan_identified)
