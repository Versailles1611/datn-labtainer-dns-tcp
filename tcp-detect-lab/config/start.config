# Filename : start.config
# Description:
#     TCP attack detection lab - analyze captures and identify TCP attacks
#

GLOBAL_SETTINGS
    GRADE_CONTAINER analyst
    HOST_HOME_XFER seed_dir/
    LAB_MASTER_SEED tcp-detect-lab_seed

NETWORK LAN
    MASK 172.22.0.0/24
    GATEWAY 172.22.0.101

CONTAINER analyst
    REGISTRY haiyen1102
    USER ubuntu
    X11 NO
    LAN 172.22.0.2
    NO_GW YES

CONTAINER victim
    REGISTRY haiyen1102
    USER ubuntu
    X11 NO
    LAN 172.22.0.3
    NO_GW YES

CONTAINER server
    REGISTRY haiyen1102
    USER ubuntu
    X11 NO
    LAN 172.22.0.4
    NO_GW YES

CONTAINER attacker
    REGISTRY haiyen1102
    USER ubuntu
    X11 NO
    LAN 172.22.0.5
    NO_GW YES
