# results.config
#
# Please see the Labtainer Lab Designer Guide
#
#CHECK_OK: Tat ca kiem tra TCP hijacking deu DAT.
#
# === Cac ket qua dung de xep hang ===
_tcp_session = server:prestop.stdout : FILE_REGEX : HELLO
_tcp_hijacked = server:prestop.stdout : CONTAINS : HIJACKED
_tcp_sniffed = attacker:prestop.stdout : FILE_REGEX : \.9999
_tcp_arp = victim:prestop.stdout : FILE_REGEX : 02:42:ac:15:00:04

# === Checkwork feedback (it nhat 3 kiem tra) ===
#CHECK_TRUE: Phien TCP giua nan nhan va server chua duoc thiet lap (thieu HELLO trong log)
cw_tcp_session = server:prestop.stdout : FILE_REGEX : HELLO
#CHECK_TRUE: Goi tin gia mao chua toi server (thieu HIJACKED trong log)
cw_tcp_hijacked = server:prestop.stdout : CONTAINS : HIJACKED
#CHECK_TRUE: Attacker chua sniff duoc phien TCP (thieu cong 9999 trong pcap)
cw_tcp_sniffed = attacker:prestop.stdout : FILE_REGEX : \.9999
#CHECK_TRUE: ARP chua bi dau doc (bang ARP cua nan nhan thieu MAC cua attacker)
cw_tcp_arp = victim:prestop.stdout : FILE_REGEX : 02:42:ac:15:00:04
