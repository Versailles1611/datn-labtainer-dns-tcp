# goals.config
#
# Please see the Labtainer Lab Designer Guide
#
# Nhiem vu cua sinh vien:
#   1) Mo phien TCP tu victim toi server (HELLO)
#   2) ARP spoofing de chen giua victim va server
#   3) Sniff phien TCP, doc so SEQ/ACK
#   4) Chen goi tin gia mao HIJACKED vao phien
#
tcp_session_ok = boolean : _tcp_session
tcp_hijacked_ok = boolean : _tcp_hijacked
tcp_sniffed_ok = boolean : _tcp_sniffed
tcp_arp_ok = boolean : _tcp_arp

#DOC: Da hijack thanh cong phien TCP tu dau den cuoi
all_passed = boolean : (tcp_session_ok and tcp_hijacked_ok and tcp_sniffed_ok and tcp_arp_ok)
