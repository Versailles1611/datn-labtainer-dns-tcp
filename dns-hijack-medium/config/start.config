# Filename : start.config
# Description:
#     Local DNS attack lab (SEED) - user, apollo-dns, attacker, gateway
#

GLOBAL_SETTINGS
    GRADE_CONTAINER user
    HOST_HOME_XFER seed_dir/
    LAB_MASTER_SEED user_mike_master_seed

NETWORK SOME_NETWORK
     MASK 192.168.0.0/24
     GATEWAY 192.168.0.101

NETWORK WAN
     MASK 10.10.0.0/24
     GATEWAY 10.10.0.101

CONTAINER user
    USER ubuntu
    REGISTRY haiyen1102
    SOME_NETWORK 192.168.0.100

CONTAINER apollo-dns
    USER ubuntu
    REGISTRY haiyen1102
    TERMINAL_GROUP gateway
    SOME_NETWORK 192.168.0.10

CONTAINER attacker
    USER ubuntu
    REGISTRY haiyen1102
    SOME_NETWORK 192.168.0.200
    TERMINALS 3
    TERMINAL_GROUP attacker
    X11 NO

CONTAINER gateway
    USER ubuntu
    REGISTRY haiyen1102
    SOME_NETWORK 192.168.0.1
    WAN 10.10.0.1
    TERMINAL_GROUP gateway
    X11 NO
