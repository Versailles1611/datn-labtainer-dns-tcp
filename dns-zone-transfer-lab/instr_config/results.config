# === Ket qua chung ===
_zone_xfer_offered = attacker:prestop.stdout : FILE_REGEX : transfer
_zone_xfer_allowed = attacker:prestop.stdout : FILE_REGEX : *.* IN *
_zone_xfer_success = attacker:prestop.stdout : FILE_REGEX : *.* IN *
_soa_record = attacker:prestop.stdout : FILE_REGEX : example\.com

# === Checkwork feedback ===
cw_zone_xfer_offered = attacker:prestop.stdout : FILE_REGEX : transfer
cw_zone_xfer_allowed = attacker:prestop.stdout : FILE_REGEX : \*\.\* IN \*
cw_zone_xfer_success = attacker:prestop.stdout : FILE_REGEX : \*\.\* IN \*
cw_soa_record = attacker:prestop.stdout : FILE_REGEX : example\.com
