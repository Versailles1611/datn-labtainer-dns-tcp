# results.config
# Please see the Labtainer Lab Designer Guide
#
#CHECK_OK: DNS zone transfer checks passed.

# 1) the server answers an AXFR request (dig reports the transfer size)
cw_zone_transfer = attacker:prestop.stdout : CONTAINS : XFR size
# 2) the SOA record is exposed
cw_soa_record = attacker:prestop.stdout : CONTAINS : SOA
# 3) the NS record is exposed
cw_ns_record = attacker:prestop.stdout : FILE_REGEX : IN\s+NS
# 4) host records of the internal network are exposed
cw_host_records = attacker:prestop.stdout : FILE_REGEX : \bA\s+172\.21\.0\.3
