# goals.config
# Please see the Labtainer Lab Designer Guide

# Tasks for the DNS zone transfer lab:
#   1) request a full zone transfer from the DNS server
#   2) read the SOA record
#   3) read the NS records
#   4) enumerate host (A) records

zone_transfer = boolean : cw_zone_transfer
soa_record = boolean : cw_soa_record
ns_record = boolean : cw_ns_record
host_records = boolean : cw_host_records

#DOC: The full example.com zone was transferred to the attacker
all_passed = boolean : (zone_transfer and soa_record and ns_record and host_records)
