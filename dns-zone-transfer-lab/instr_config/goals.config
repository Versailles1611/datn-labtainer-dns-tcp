# goals.config
# Please see the Labtainer Lab Designer Guide

# Nhiem vu cua sinh vien:
#   1) Thuc hien zone transfer tu may attacker
#   2) Kiem tra xem DNS server co phuc vu zone transfer duoc cau hinh khong
#   3) Doc SOA record tu ket qua zone transfer
#   4) Kiem tra thong tin danh muc may chu

zone_xfer_ok = boolean : _zone_xfer_offered
zone_allowed_ok = boolean : _zone_xfer_allowed
zone_success_ok = boolean : _zone_xfer_success
soa_record_ok = boolean : _soa_record

#DOC: Kiem tra thanh cong kien hanh zone transfer va doc du lieu DNS
all_passed = boolean : (zone_xfer_ok and zone_allowed_ok and zone_success_ok and soa_record_ok)
