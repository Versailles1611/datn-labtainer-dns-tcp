# Filename : start.config
# Description:
#     TCP Sequence Prediction lab - Predicting sequence numbers to hijack connections
#

GLOBAL_SETTINGS
	GRADE_CONTAINER server
	HOST_HOME_XFER seed_dir/
	LAB_MASTER_SEED pred-hijack-lab_seed

NETWORK LAN
     MASK 172.21.0.0/24
     GATEWAY 172.21.0.101

CONTAINER victim
	USER ubuntu
    	LAN 172.21.0.2
    	NO_GW YES
    	REGISTRY haiyen1102

CONTAINER server
	USER ubuntu
    	LAN 172.21.0.3
    	NO_GW YES
    	REGISTRY haiyen1102

CONTAINER attacker
	USER ubuntu
    	LAN 172.21.0.4
    	NO_GW YES
    	REGISTRY haiyen1102
