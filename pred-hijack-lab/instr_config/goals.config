# goals.config
# Please see the Labtainer Lab Designer Guide

# Tasks for the TCP sequence prediction lab:
#   1) open a TCP session between victim and server
#   2) predict the next sequence number
#   3) inject a HIJACKED segment accepted by the server
#   4) capture the session and verify the victim ARP cache

tcp_session_established = boolean : cw_tcp_session
tcp_data_injected = boolean : cw_tcp_injected
server_acknowledged = boolean : cw_tcp_acked
arp_cache_poisoned = boolean : cw_arp_spoof

#DOC: A spoofed segment was injected using a predicted TCP sequence number
all_passed = boolean : (tcp_session_established and tcp_data_injected)
