# goals.config
# Please see the Labtainer Lab Designer Guide

# Nhiem vu cua sinh vien:
#   1) Tinh doan so sequence tiep theo cua victim de chen goi tin
#   2) Chen goi tin du lieu vao phien TCP bieu tieu
#   3) Kiem tra server da chap nhan goi tin du lieu

data_injected_ok = boolean : _tcp_data_sent
server_acked_ok = boolean : _tcp_server_acked
victim_seq_ok = boolean : _tcp_victim_seq

#DOC: Dinh doan va chen goi tin vao phien TCP bieu tieu
all_passed = boolean : (data_injected_ok and server_acked_ok and victim_seq_ok)
