# results.config
# Please see the Labtainer Lab Designer Guide
#
#CHECK_OK: All TCP sequence prediction checks passed.

# 1) the victim opened a session and the server saw its data
cw_tcp_session = server:prestop.stdout : CONTAINS : HELLO
# 2) the predicted-sequence segment was accepted by the server
cw_tcp_injected = server:prestop.stdout : CONTAINS : HIJACKED
# 3) the server acknowledged the injected data
cw_tcp_acked = server:prestop.stdout : FILE_REGEX : ACK:
# 4) the victim ARP cache points at the attacker MAC (02:42:ac:15:00:04)
cw_arp_spoof = victim:prestop.stdout : CONTAINS : 02:42:ac:15:00:04
